{
  "name": "turn2opinion-website",
  "private": true,
  "version": "2.0.0",
  "description": "Turn2Opinion \u2013 paid online surveys for consumers and business professionals. React + Vite, prerendered per route for SEO.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "check:content": "node scripts/check-content.mjs",
    "seo:report": "node scripts/seo-report.mjs",
    "preview:single": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
