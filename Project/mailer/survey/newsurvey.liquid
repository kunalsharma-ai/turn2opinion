<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Survey Available - Turn2Opinion</title>
  </head>

  <body style="
    margin:0;
    padding:0;
    background:#f4f7fb;
    font-family:Arial,Helvetica,sans-serif;
  ">

    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      bgcolor="#f4f7fb"
      style="
    margin:0;
    padding:0;
    background:#f4f7fb;
  ">
      <tr>
        <td align="center" style="padding:35px 15px;">

          <table
            width="920"
            border="0"
            cellspacing="0"
            cellpadding="0"
            bgcolor="#ffffff"
            style="
    width:920px;
    max-width:920px;
    background:#ffffff;
    border-radius:14px;
    overflow:hidden;
  ">

            <!-- TOP BLUE BAR -->
            <tr>
              <td
                height="10"
                bgcolor="#0c5adb"
                style="background:#0c5adb;"></td>
            </tr>

            <!-- LOGO -->
            <tr>
              <td align="center" style="
    padding:28px 20px 24px;
    background:#ffffff;
  ">
                <img
                  src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
                  alt="Turn2Opinion"
                  width="320"
                  style="
    display:block;
    width:320px;
    max-width:90%;
    height:auto;
    border:0;
  " />
              </td>
            </tr>

            <!-- BLUE DIVIDER -->
            <tr>
              <td
                height="3"
                bgcolor="#063686"
                style="background:#063686;"></td>
            </tr>

            <!-- HERO -->
            <tr>
              <td align="center" style="
    padding:50px 40px 45px;
    background:#eef5ff;
  ">

                <!-- Decorative Dots -->
                <table
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  align="center">
                  <tr>

                    <td style="
    padding:0 12px;
    color:#0c5adb;
    font-size:28px;
    font-weight:bold;
  ">
                      •
                    </td>

                    <td style="
    padding:0 12px;
    color:#063686;
    font-size:38px;
    font-weight:bold;
  ">
                      •
                    </td>

                    <td style="
    padding:0 12px;
    color:#0c5adb;
    font-size:24px;
    font-weight:bold;
  ">
                      •
                    </td>

                    <td style="
    padding:0 12px;
    color:#063686;
    font-size:32px;
    font-weight:bold;
  ">
                      •
                    </td>

                    <td style="
    padding:0 12px;
    color:#0c5adb;
    font-size:26px;
    font-weight:bold;
  ">
                      •
                    </td>

                  </tr>
                </table>

                <!-- MAIN HEADING -->
                <h1 style="
    margin:28px 0 8px;
    color:#063686;
    font-size:44px;
    line-height:54px;
    font-weight:bold;
  ">
                  New Survey Available
                </h1>

                <!-- GREETING -->
                <p style="
    margin:12px 0 0;
    color:#0c5adb;
    font-size:18px;
    line-height:28px;
    font-weight:bold;
  ">
                  Hey {{ user.name.first }}!
                </p>

                <!-- SECONDARY HEADING -->
                <h2 style="
    margin:6px 0 0;
    color:#063686;
    font-size:28px;
    line-height:38px;
    font-weight:bold;
  ">
                  We Want Your Opinion
                </h2>

                <!-- DESCRIPTION -->
                <p style="
    margin:22px auto 0;
    max-width:680px;
    color:#344d70;
    font-size:20px;
    line-height:32px;
  ">
                  A new survey is waiting for you on
                  <strong>Turn2Opinion</strong>.  
  Share your opinion and earn rewards for your valuable insights.
                </p>

              </td>
            </tr>

            <!-- SURVEY DETAILS -->
            <tr>
              <td style="padding:40px 55px 20px;">

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
    background:#ffffff;
    border:1px solid #cfe0f5;
    border-radius:16px;
  ">

                  <tr>

                    <!-- REWARD PANEL -->
                    <td
                      width="180"
                      align="center"
                      valign="middle"
                      style="
    padding:35px 15px;
    background:#eef5ff;
    border-radius:16px 0 0 16px;
  ">

                      <table
                        border="0"
                        cellspacing="0"
                        cellpadding="0"
                        align="center">

                        <tr>
                          <td align="center" style="
    color:#0c5adb;
    font-size:54px;
    line-height:60px;
    font-weight:bold;
  ">
                            ★
                          </td>
                        </tr>

                        <tr>
                          <td align="center" style="
    padding-top:8px;
    color:#063686;
    font-size:16px;
    font-weight:bold;
    letter-spacing:1px;
  ">
                            EARN REWARDS
                          </td>
                        </tr>

                      </table>

                    </td>

                    <!-- SURVEY INFORMATION -->
                    <td valign="middle" style="
    padding:38px 40px;
  ">

                      <h2 style="
    margin:0 0 18px;
    color:#063686;
    font-size:28px;
    line-height:36px;
  ">
                        {{ survey.name }}
                      </h2>

                      <table
                        width="100%"
                        border="0"
                        cellspacing="0"
                        cellpadding="0"
                        style="
    font-size:17px;
    color:#344d70;
  ">

                        <!-- POINTS -->
                        <tr>

                          <td style="
    padding:10px 0;
    color:#063686;
    font-weight:bold;
    border-bottom:1px solid #e1eaf6;
  ">
                            Points
                          </td>

                          <td style="
    padding:10px 0;
    border-bottom:1px solid #e1eaf6;
  ">
                            <strong style="color:#0c5adb;">
                              {{ survey.points }} points
                            </strong>
                          </td>

                        </tr>

                        <!-- ESTIMATED TIME -->
                        <tr>

                          <td style="
    padding:10px 0;
    color:#063686;
    font-weight:bold;
  ">
                            Estimated Time
                          </td>

                          <td style="padding:10px 0;">
                            {{ survey.time }} minutes
                          </td>

                        </tr>

                      </table>

                    </td>

                  </tr>

                </table>

              </td>
            </tr>

            <!-- SURVEY CTA -->
            <tr>
              <td style="padding:20px 55px 35px;">

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
    background:#063686;
    border-radius:16px;
  ">

                  <tr>
                    <td align="center" style="
    padding:38px 35px;
  ">

                      <p style="
    margin:0 0 10px;
    color:#bcd5ff;
    font-size:17px;
    font-weight:bold;
    letter-spacing:1.5px;
    text-transform:uppercase;
  ">
                        Your Opinion Matters
                      </p>

                      <h2 style="
    margin:0 0 14px;
    color:#ffffff;
    font-size:30px;
    line-height:40px;
  ">
                        Ready to share your thoughts?
                      </h2>

                      <p style="
    margin:0 auto 25px;
    max-width:650px;
    color:#dce9ff;
    font-size:17px;
    line-height:28px;
  ">
                        Your insights help brands and organizations make  
  better decisions. Complete this survey and earn
  rewards for your time.
                      </p>

                      <!-- START SURVEY BUTTON -->
                      <a
                        href=""
                        target="_blank"
                        style="
    display:inline-block;
    background:#0c5adb;
    color:#ffffff;
    text-decoration:none;
    padding:15px 40px;
    border-radius:10px;
    font-size:17px;
    font-weight:bold;
  ">
                        START SURVEY
                      </a>

                      <!-- RAW LINK -->
                      <p style="
    margin:20px 0 8px;
    color:#dce9ff;
    font-size:14px;
    line-height:22px;
  ">
                        Or copy and paste the following link into your browser:
                      </p>

                      <p style="
    margin:0;
    font-size:14px;
    line-height:22px;
    word-break:break-all;
  ">
                        <a
                          href=""
                          target="_blank"
                          style="
      color:#ffffff;
      text-decoration:underline;
    ">
                          SURVEY_LINK
                        </a>
                      </p>

                      <!-- SUPPORT MESSAGE -->
                      <p style="
    margin:20px auto 0;
    max-width:650px;
    color:#dce9ff;
    font-size:14px;
    line-height:23px;
  ">
                        If you can’t see or click the above button, please drop a note at
                        <a href="mailto:support@turn2opinion.com" style="
      color:#ffffff;
      text-decoration:underline;
      font-weight:bold;
    ">
                          support@turn2opinion.com
                        </a>,  
  we would be glad to assist.
                      </p>

                    </td>
                  </tr>

                </table>

              </td>
            </tr>

            <!-- CLOSING MESSAGE -->
            <tr>
              <td align="center" style="
    padding:15px 60px 40px;
  ">

                <table
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  align="center">

                  <tr>

                    <td
                      height="3"
                      width="55"
                      bgcolor="#0c5adb"></td>

                    <td width="15"></td>

                    <td
                      height="3"
                      width="55"
                      bgcolor="#063686"></td>

                  </tr>

                </table>

                <p style="
    margin:20px 0 0;
    color:#063686;
    font-size:20px;
    line-height:32px;
    font-weight:bold;
    font-style:italic;
  ">
                  Your opinion makes a difference.
                </p>

              </td>
            </tr>

            {% include "mailer/footer.liquid" %}
            <!-- BOTTOM BLUE BAR -->
            <tr>

              <td
                height="10"
                bgcolor="#0c5adb"
                style="background:#0c5adb;"></td>

            </tr>
          </table>

        </td>
      </tr>
    </table>

  </body>
</html>