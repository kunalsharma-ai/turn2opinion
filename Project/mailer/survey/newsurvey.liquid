<table width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
      <img
        src="https://turn2opinion.com/images/logo.png"
        alt="Turn2Opinions"
        style="width: 282px; height: auto; margin: 20px 0; padding: 0"
      />
    </td>
  </tr>
</table>

<div
  style="
    max-width: 600px;
    margin: auto;
    background: #f8f8f8;
    border: 1px solid rgba(89, 172, 119, 0.3);
    border-radius: 6px;
  "
>
  <div style="padding: 30px 20px; font-family: Roboto, sans-serif">
    <h2 style="text-align: center; color: #2a3940; font-weight: 400; margin: 0">
      Hey {{user.name.first}},
    </h2>

    <p
      style="
        font-size: 17px;
        color: #2a3940;
        text-align: center;
        margin: 20px 0;
      "
    >
      A new survey is now available for you on Turn2Opinions.
    </p>

    <table
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="
        background: #ffffff;
        border: 1px solid #dcdcdc;
        border-radius: 4px;
        font-family: Roboto, sans-serif;
        font-size: 15px;
        color: #2a3940;
        margin: 30px auto;
      "
    >
      <tr>
        <td
          style="
            padding: 12px 10px;
            border-bottom: 1px solid #eaeaea;
            font-weight: 600;
            width: 40%;
          "
        >
          Survey Name
        </td>
        <td style="padding: 12px 10px; border-bottom: 1px solid #eaeaea">
          {{survey.name}}
        </td>
      </tr>

      <tr>
        <td
          style="
            padding: 12px 10px;
            border-bottom: 1px solid #eaeaea;
            font-weight: 600;
          "
        >
          Category
        </td>
        <td style="padding: 12px 10px; border-bottom: 1px solid #eaeaea">
          {{survey.category}}
        </td>
      </tr>

      <tr>
        <td
          style="
            padding: 12px 10px;
            border-bottom: 1px solid #eaeaea;
            font-weight: 600;
          "
        >
          Points
        </td>
        <td style="padding: 12px 10px; border-bottom: 1px solid #eaeaea">
          {{survey.points}}
        </td>
      </tr>

      <tr>
        <td style="padding: 12px 10px; font-weight: 600">Estimated Time</td>
        <td style="padding: 12px 10px">{{survey.time}} minutes</td>
      </tr>
    </table>

    <p
      style="
        font-size: 17px;
        color: #2a3940;
        text-align: center;
        margin: 20px 0;
      "
    >
      Your insights matter, and we'd appreciate your participation. Click below
      to start the survey.
    </p>

    <div style="text-align: center; margin: 55px 0">
      <a
        href=""
        target="_blank"
        style="
          display: inline-block;
          background: #e48025;
          color: #fff;
          padding: 12px 40px;
          text-decoration: none;
          font-size: 18px;
          border-radius: 2px;
        "
      >
        Start Survey
      </a>
    </div>

    <hr style="border: 0; border-top: 2px solid #e8e8e8; margin: 30px 0" />

      {% include  "mailer/footer.liquid" %}
  </div>
</div>
