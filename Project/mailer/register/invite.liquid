<table width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
     <img
        src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
        alt="Turn2Opinions"
        style="width: 282px; height: auto; margin: 20px 0; padding: 0"
      />
    </td>
  </tr>
</table>

<div
  style="
    max-width: 600px;
    margin: auto;
    background: #f8f8f8;
    border: 1px solid rgba(89, 172, 119, 0.3);
    border-radius: 6px;
  "
>
  <div style="padding: 30px 20px; font-family: Roboto, sans-serif">
    <h2 style=" color: #2a3940; font-weight: 400; margin: 0">
      Hey,
    </h2>

    <p
      style="
        font-size: 17px;
        color: #2a3940;
        
        margin: 20px 0;
      "
    >
       We're reaching out on behalf of {{user.fullName}} who wanted to invite you to explore Turn2Opinions — a platform where people share insights, participate in questionnaires, and get rewarded for it.
    </p>

    <p
      style="
        font-size: 17px;
        color: #2a3940;
        
        margin: 20px 0;
      "
    >
      You can join the website by clicking the link below:
    </p>

    <div style="text-align: center; margin: 55px 0">
      <a
       href="{{ref.link}}"
        target="_blank"
        style="
          display: inline-block;
          background: #063686;
          color: #fff;
          padding: 12px 40px;
          text-decoration: none;
          font-size: 18px;
          border-radius: 2px;
        "
      >
        Join
      </a>
    </div>

      <p
      style="
        font-size: 15px;
        color: #2a3940;
        
        margin: 20px 0;
      "
    >
     If this wasn’t intended for you, please feel free to ignore this message.
    </p>
    <hr style="border: 0; border-top: 2px solid #e8e8e8; margin: 30px 0" />

     {% include  "mailer/footer.liquid" %}
  </div>
</div>