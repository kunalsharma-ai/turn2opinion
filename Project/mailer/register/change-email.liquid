<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="max-width: 920px">
        <!-- TOP BORDER -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- LOGO SECTION -->
        <tr>
          <td align="center" style="padding: 30px 20px; background: #ffffff">
            <img
              src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
              alt="Turn2Opinion.com"
              width="420"
              style="display: block; max-width: 100%" />
          </td>
        </tr>

        <!-- HEADER DIVIDER -->
        <tr>
          <td height="1" bgcolor="#002b8f"></td>
        </tr>

        <!-- INTRO -->
        <tr>
          <td style="padding: 35px 60px 15px">
            <p style="
                margin: 0 0 25px;
                font-size: 28px;
                color: #063686;
                font-weight: bold;
              ">
              Hey {{ user.name.first }},
            </p>

            <p style="
                margin: 0;
                font-size: 22px;
                line-height: 38px;
                color: #14245d;
              ">
              We have received a request to change your registered email 
              address on Turn2Opinion - A Frequent Research Survey Panel.
            </p>
          </td>
        </tr>

        <!-- EMAIL CHANGE CARD -->
        <tr>
          <td style="padding: 30px 55px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                border: 1px solid #bfdbfe;
                border-radius: 12px;
                background: #f0f9ff;
              ">
              <tr>
                <td style="padding: 40px 45px">
                  <h2 style="
                      margin: 0 0 20px;
                      color: #063686;
                      font-size: 30px;
                    ">
                    Confirm Your Email Change
                  </h2>

                  <p style="
                      margin: 0 0 20px;
                      color: #17285f;
                      font-size: 20px;
                      line-height: 34px;
                    ">
                    We have received a request to change your registered email 
                    ID from
                    <strong>{{ user.mail }}</strong>
                    to
                    <strong>{{ email }}</strong>.
                  </p>

                  <p style="
                      margin: 0;
                      color: #17285f;
                      font-size: 20px;
                      line-height: 34px;
                    ">
                    To complete the process and confirm the request, please 
                    click the button below. The verification link is valid for
                    24 hours.
                  </p>

                  <!-- VERIFY BUTTON -->
                  <table
                    width="100%"
                    border="0"
                    cellspacing="0"
                    cellpadding="0"
                    style="margin-top: 40px">
                    <tr>
                      <td align="center">
                        <a
                          href="https://{{user.origin}}/auth/change-email?confcode={{token}}"
                          target="_blank"
                          style="
                            display: inline-block;
                            background: #063686;
                            color: #ffffff;
                            padding: 14px 45px;
                            text-decoration: none;
                            font-size: 18px;
                            font-weight: bold;
                            border-radius: 4px;
                          ">
                          Click to Verify
                        </a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- SECURITY NOTICE -->
        <tr>
          <td style="padding: 0 55px 35px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #f8fbff;
                border: 1px solid #d7e4ff;
                border-radius: 10px;
              ">
              <tr>
                <td style="padding: 25px">
                  <h3 style="
                      margin: 0 0 10px;
                      color: #063686;
                      font-size: 22px;
                    ">
                    Didn't Make This Request?
                  </h3>

                  <p style="
                      margin: 0;
                      font-size: 18px;
                      line-height: 30px;
                      color: #22305f;
                    ">
                    Please let us know if you have not requested to change 
                    your email address or are unaware of this activity.
                    Contact us at
                    <a href="mailto:support@frequentresearch.com" style="
                        color: #063686;
                        text-decoration: none;
                        font-weight: bold;
                      ">
                      support@frequentresearch.com
                    </a>
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% include "mailer/footer.liquid" %}
        <!-- BOTTOM BLUE BAR -->
        <tr>

          <td
            height="10"
            bgcolor="#0c5adb"
            style="background:#0c5adb;"></td>

        </tr>
      </table>
    </td>
  </tr>
</table>