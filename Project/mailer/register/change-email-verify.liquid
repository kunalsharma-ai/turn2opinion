<table width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
    <img
        src="https://turn2opinion.com/images/logo.png"
        alt="Turn2Opinions"
        style="width: 282px; height: auto; margin: 20px 0; padding: 0"
      />

    </td>
  </tr>
</table>

<div
  style="
    max-width: 600px;
    margin: auto;
    background: #f8f8f8;
    border: 1px solid rgba(89, 172, 119, 0.3);
    border-radius: 6px;
  "
>
  <div style="padding: 30px 20px; font-family: Roboto, sans-serif">
    <h2 style="text-align: center; color: #2a3940; font-weight: 400; margin: 0">
      Hey {{user.name.first}},
    </h2>

    <p
      style="
        font-size: 17px;
        color: #2a3940;
        text-align: center;
        margin: 20px 0;
      "
    >
      We have received a request to change your registered email from
      <strong>{{user.mail}}</strong> to <strong>{{email}}</strong>.
    </p>

    <p
      style="
        font-size: 17px;
        color: #2a3940;
        text-align: center;
        margin: 20px 0;
      "
    >
      To confirm this request, click the verification link below. The link is
      valid for 24 hours.
    </p>

    <div style="text-align: center; margin: 55px 0">
      <a
        href="https://{{user.origin}}/auth/change-email?updatecode={{token}}"
        target="_blank"
        style="
          display: inline-block;
          background: #ff5500;
          color: #fff;
          padding: 12px 40px;
          text-decoration: none;
          font-size: 18px;
          border-radius: 2px;
        "
      >
        Click to verify
      </a>
    </div>

    <hr style="border: 0; border-top: 2px solid #e8e8e8; margin: 30px 0" />

        {% include  "mailer/footer.liquid" %}
  </div>
</div>
