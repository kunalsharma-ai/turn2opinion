<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="max-width: 920px">
        <!-- TOP BORDER -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- LOGO SECTION -->
        <tr>
          <td align="center" style="padding: 30px 20px; background: #ffffff">
            <img
              src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
              alt="Turn2Opinion.com"
              width="420"
              style="display: block; max-width: 100%" />
          </td>
        </tr>

        <!-- HEADER DIVIDER -->
        <tr>
          <td height="1" bgcolor="#002b8f"></td>
        </tr>

        <!-- INTRO -->
        <tr>
          <td style="padding: 35px 60px 15px">
            <p style="
                margin: 0 0 25px;
                font-size: 28px;
                color: #063686;
                font-weight: bold;
              ">
              Hey,
            </p>

            <p style="
                margin: 0;
                font-size: 22px;
                line-height: 38px;
                color: #14245d;
              ">
              Your password has been successfully created, and your 
              Turn 2 Opinion Panel Community account is now active.
            </p>
          </td>
        </tr>

        <!-- ACCOUNT ACTIVATION CARD -->
        <tr>
          <td style="padding: 30px 55px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                border: 1px solid #bfdbfe;
                border-radius: 12px;
                background: #f0f9ff;
              ">
              <tr>
                <td style="padding: 40px 45px">
                  <h2 style="
                      margin: 0 0 20px;
                      color: #063686;
                      font-size: 30px;
                    ">
                    Your Account Is Ready
                  </h2>

                  <p style="
                      margin: 0;
                      color: #17285f;
                      font-size: 20px;
                      line-height: 34px;
                    ">
                    You can now log in to your dashboard, update your details, 
                    and start participating in healthcare market research
                    studies tailored to your profile.
                  </p>

                  <!-- LOGIN BUTTON -->
                  <table
                    width="100%"
                    border="0"
                    cellspacing="0"
                    cellpadding="0"
                    style="margin-top: 40px">
                    <tr>
                      <td align="center">
                        <a
                          href="http://{{user.origin}}/?login"
                          target="_blank"
                          style="
                            display: inline-block;
                            background: #063686;
                            color: #ffffff;
                            padding: 14px 45px;
                            text-decoration: none;
                            font-size: 18px;
                            font-weight: bold;
                            border-radius: 4px;
                          ">
                          Login
                        </a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- CLOSING NOTICE -->
        <tr>
          <td style="padding: 0 55px 35px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #f8fbff;
                border: 1px solid #d7e4ff;
                border-radius: 10px;
              ">
              <tr>
                <td style="padding: 25px">
                  <p style="
                      margin: 0;
                      font-size: 18px;
                      line-height: 30px;
                      color: #22305f;
                    ">
                    We look forward to your valuable participation and 
                    insights.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {% include "mailer/footer.liquid" %}
        <!-- BOTTOM BLUE BAR -->
        <tr>

          <td
            height="10"
            bgcolor="#0c5adb"
            style="background:#0c5adb;"></td>

        </tr>
      </table>
    </td>
  </tr>
</table>