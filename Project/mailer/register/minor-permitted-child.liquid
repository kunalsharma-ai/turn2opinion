<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="max-width: 920px">
        <!-- TOP BORDER -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- LOGO SECTION -->
        <tr>
          <td align="center" style="padding: 30px 20px; background: #ffffff">
            <img
              src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
              alt="Turn2Opinion.com"
              width="420"
              style="display: block; max-width: 100%" />
          </td>
        </tr>

        <tr>
          <td height="1" bgcolor="#002b8f"></td>
        </tr>

        <!-- INTRO -->
        <tr>
          <td style="padding: 35px 60px 15px">
            <p style="
            margin: 0 0 25px;
            font-size: 28px;
            color: #063686;
            font-weight: bold;
          ">
              Hi {{ user.name.first }},
            </p>

            <p style="
            margin: 0;
            font-size: 22px;
            line-height: 38px;
            color: #14245d;
          ">
              Great news! Your parent or guardian has successfully confirmed 
          their consent for your participation on Turn2Opinion.
            </p>
          </td>
        </tr>

        <!-- APPROVAL CARD -->
        <tr>
          <td style="padding: 30px 55px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
            border: 1px solid #bfdbfe;
            border-radius: 12px;
            background: #f0f9ff;
          ">
              <tr>
                <td
                  width="220"
                  align="center"
                  style="padding: 40px 10px">
                  <img
                    src="https://frequentresearch.com/mailer/mail-icons/t2o/mail.png"
                    width="160"
                    alt="Registration Approved" />
                </td>

                <td style="padding: 35px 10px">
                  <h2 style="
                  margin: 0 0 15px;
                  color: #063686;
                  font-size: 30px;
                ">
                    Your Registration Is Approved
                  </h2>

                  <p style="
                  margin: 0;
                  color: #17285f;
                  font-size: 20px;
                  line-height: 34px;
                ">
                    You can now access eligible surveys, share your opinions, 
                and earn rewards for your participation on Turn2Opinion.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- IMPORTANT NOTICE -->
        <tr>
          <td style="padding: 0 55px 35px">
            <table width="100%" style="
            background: #f8fbff;
            border: 1px solid #d7e4ff;
            border-radius: 10px;
          ">
              <tr>
                <td
                  width="120"
                  align="center"
                  style="padding: 25px">
                  <img
                    src="https://frequentresearch.com/mailer/mail-icons/t2o/shield.png"
                    width="100"
                    alt="Important" />
                </td>

                <td style="padding: 25px 25px 25px 0">
                  <h3 style="
                  margin: 0 0 10px;
                  color: #063686;
                  font-size: 22px;
                ">
                    A Quick Reminder
                  </h3>

                  <p style="
                  margin: 0;
                  font-size: 18px;
                  line-height: 30px;
                  color: #22305f;
                ">
                    Please provide accurate information when completing your 
                profile and surveys. This helps us ensure that you receive
                surveys that are relevant to you.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- WELCOME -->
        <tr>
          <td style="padding: 0 60px 35px">
            <p style="
            margin: 0;
            font-size: 22px;
            line-height: 36px;
            color: #14245d;
            text-align: center;
          ">
              Welcome to Turn2Opinion — we're glad to have you with us!
            </p>
          </td>
        </tr>

        {% include "mailer/footer.liquid" %}

        <!-- BOTTOM BLUE BAR -->
        <tr>
          <td
            height="10"
            bgcolor="#0c5adb"
            style="background:#0c5adb;"></td>
        </tr>

      </table>
    </td>

  </tr>
</table>