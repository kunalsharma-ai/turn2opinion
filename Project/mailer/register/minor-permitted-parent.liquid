<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="max-width: 920px">
        <!-- TOP BORDER -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- LOGO SECTION -->
        <tr>
          <td align="center" style="padding: 30px 20px; background: #ffffff">
            <img
              src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
              alt="Turn2Opinion.com"
              width="420"
              style="display: block; max-width: 100%" />
          </td>
        </tr>

        <tr>
          <td height="1" bgcolor="#002b8f"></td>
        </tr>

        <!-- INTRO -->
        <tr>
          <td style="padding: 35px 60px 15px">
            <p style="
            margin: 0 0 25px;
            font-size: 28px;
            color: #063686;
            font-weight: bold;
          ">
              Dear {{ user.parent.name.first }},
            </p>

            <p style="
            margin: 0;
            font-size: 22px;
            line-height: 38px;
            color: #14245d;
          ">
              Thank you for confirming your consent for your child,
              <strong>{{ user.name.first }}</strong>, to participate in 
          Turn2Opinion.
            </p>
          </td>
        </tr>

        <!-- APPROVAL CARD -->
        <tr>
          <td style="padding: 30px 55px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
            border: 1px solid #bfdbfe;
            border-radius: 12px;
            background: #f0f9ff;
          ">
              <tr>
                <td
                  width="220"
                  align="center"
                  style="padding: 40px 10px">
                  <img
                    src="https://frequentresearch.com/mailer/mail-icons/t2o/mail.png"
                    width="160"
                    alt="Parental Consent Confirmed" />
                </td>

                <td style="padding: 35px 10px">
                  <h2 style="
                  margin: 0 0 15px;
                  color: #063686;
                  font-size: 30px;
                ">
                    Consent Successfully Recorded
                  </h2>

                  <p style="
                  margin: 0;
                  color: #17285f;
                  font-size: 20px;
                  line-height: 34px;
                ">
                    Your parental approval has been successfully recorded, 
                and
                    <strong>{{ user.name.first }}</strong>'s registration 
                is now approved.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- PARTICIPATION -->
        <tr>
          <td style="padding: 0 55px 35px">
            <table width="100%" style="
            background: #f8fbff;
            border: 1px solid #d7e4ff;
            border-radius: 10px;
          ">
              <tr>
                <td
                  width="120"
                  align="center"
                  style="padding: 25px">
                  <img
                    src="https://frequentresearch.com/mailer/mail-icons/t2o/shield.png"
                    width="100"
                    alt="Participant Safety" />
                </td>

                <td style="padding: 25px 25px 25px 0">
                  <h3 style="
                  margin: 0 0 10px;
                  color: #063686;
                  font-size: 22px;
                ">
                    Participation on Turn2Opinion
                  </h3>

                  <p style="
                  margin: 0;
                  font-size: 18px;
                  line-height: 30px;
                  color: #22305f;
                ">
                    <strong>{{ user.name.first }}</strong>
                    may now participate 
                in eligible surveys and earn rewards by sharing their
                opinions on various topics.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- RESPONSIBLE RESEARCH -->
        <tr>
          <td style="padding: 0 60px 35px">
            <p style="
            margin: 0 0 20px;
            font-size: 20px;
            line-height: 34px;
            color: #14245d;
            text-align: center;
          ">
              We appreciate your cooperation and support in helping us 
          maintain a safe and responsible research environment for all
          participants.
            </p>

            <p style="
            margin: 0;
            font-size: 18px;
            line-height: 30px;
            color: #22305f;
            text-align: center;
          ">
              If you have any questions, would like to withdraw your consent, 
          or request account deletion, please contact our support team.
            </p>
          </td>
        </tr>

        {% include "mailer/footer.liquid" %}

        <!-- BOTTOM BLUE BAR -->
        <tr>
          <td
            height="10"
            bgcolor="#0c5adb"
            style="background:#0c5adb;"></td>
        </tr>

      </table>
    </td>


  </tr>
</table>