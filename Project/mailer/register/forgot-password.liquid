<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="max-width: 920px">
        <!-- TOP BORDER -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- LOGO SECTION -->
        <tr>
          <td align="center" style="padding: 30px 20px; background: #ffffff">
            <img
              src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
              alt="Turn2Opinion.com"
              width="420"
              style="display: block; max-width: 100%" />
          </td>
        </tr>
        <tr>
          <td height="1" bgcolor="#002b8f"></td>
        </tr>

        <!-- INTRO -->
        <tr>
          <td style="padding: 35px 60px 15px">
            <p style="
                margin: 0 0 25px;
                font-size: 28px;
                color: #063686;
                font-weight: bold;
              ">
              Hi {{ user.name.first }},
            </p>

            <p style="
                margin: 0;
                font-size: 22px;
                line-height: 38px;
                color: #14245d;
              ">
              We received a request to reset your password for your Turn2Opinion panel account.
            </p>
          </td>
        </tr>

        <!-- VERIFY CARD -->
        <tr>
          <td style="padding: 30px 55px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                border: 1px solid #bfdbfe;
                border-radius: 12px;
                background: #f0f9ff;
              ">
              <tr>
                <td
                  width="220"
                  align="center"
                  style="padding: 40px 10px">
                  <img
                    src="https://frequentresearch.com/mailer/mail-icons/t2o/mail.png"
                    width="160"
                    alt="Verify Email" />
                </td>

                <td style="padding: 35px 10px">
                  <h2 style="margin: 0 0 15px; color: #063686; font-size: 30px">
                    Reset Your Account Password
                  </h2>

                  <p style="
                      margin: 0 0 30px;
                      color: #17285f;
                      font-size: 20px;
                      line-height: 34px;
                    ">
                    If you've made this request, please click the link below to set a new password:
                  </p>

                  <a href="http://{{user.origin}}/auth/password?user={{user._id}}&code={{otp.code}}" style="
                      display: inline-block;
                      background: #1e40af;
                      color: #ffffff;
                      text-decoration: none;
                      padding: 18px 45px;
                      border-radius: 12px;
                      font-size: 18px;
                      font-weight: bold;
                    ">
                    RESET PASSWORD
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>


        <!-- SECURITY NOTICE -->
        <tr>
          <td style="padding: 0 55px 35px">
            <table width="100%" style="
                background: #f8fbff;
                border: 1px solid #d7e4ff;
                border-radius: 10px;
              ">
              <tr>
                <td
                  width="120"
                  align="center"
                  style="padding: 25px">
                  <img
                    src="https://frequentresearch.com/mailer/mail-icons/t2o/shield.png"
                    width="100"
                    alt="Security" />
                </td>

                <td style="padding: 25px 25px 25px 0">
                  <h3 style="margin: 0 0 10px; color: #063686; font-size: 22px">
                    Didn't Request?
                  </h3>

                  <p style="
                      margin: 0;
                      font-size: 18px;
                      line-height: 30px;
                      color: #22305f;
                    ">
                    If you did not request a password reset for the Turn2Opinion Panel account,<br/>
                    please ignore this message. No further action is required.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% include "mailer/footer.liquid" %}
        <!-- BOTTOM BLUE BAR -->
        <tr>

          <td
            height="10"
            bgcolor="#0c5adb"
            style="background:#0c5adb;"></td>

        </tr>
      </table>
    </td>
  </tr>
</table>