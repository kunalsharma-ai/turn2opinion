<table width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">
     <img
        src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
        alt="Turn2Opinions"
        style="width: 282px; height: auto; margin: 20px 0; padding: 0"
      />
    </td>
  </tr>
</table>

<div
  style="
    max-width: 600px;
    margin: auto;
    background: #f8f8f8;
    border: 1px solid rgba(89, 172, 119, 0.3);
    border-radius: 6px;
  "
>
  <div style="padding: 30px 20px; font-family: Roboto, sans-serif">
    <h2 style="color: #2a3940; font-weight: 400; margin: 0">
      Hey {{user.name.first}},
    </h2>

    <p
      style="
        font-size: 17px;
        color: #2a3940;
        
        margin: 20px 0;
      "
    >
        We received a request to reset your password for your Turn2Opinions account.
    </p>

    <p
      style="
        font-size: 17px;
        color: #2a3940;
        
        margin: 20px 0;
      "
    >
      If you've made this request, please click the link below to set a new password:
    </p>

    <div style="text-align: center; margin: 55px 0">
      <a
       href="http://{{user.origin}}/auth/password?user={{user._id}}&code={{otp.code}}"
        target="_blank"
        style="
          display: inline-block;
          background: #063686;
          color: #fff;
          padding: 12px 40px;
          text-decoration: none;
          font-size: 18px;
          border-radius: 2px;
        "
      >
        Reset Password
      </a>
    </div>

      <p
      style="
        font-size: 15px;
        color: #2a3940;
        
        margin: 20px 0;
      "
    >
      If you did not request a password reset, please ignore this email.
    </p>
    <hr style="border: 0; border-top: 2px solid #e8e8e8; margin: 30px 0" />

     {% include  "mailer/footer.liquid" %}
  </div>
</div>