<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="max-width: 920px">
        <!-- TOP BORDER -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- LOGO SECTION -->
        <tr>
          <td align="center" style="padding: 30px 20px; background: #ffffff">
            <img
              src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
              alt="Turn2Opinion.com"
              width="420"
              style="display: block; max-width: 100%" />
          </td>
        </tr>

        <!-- HEADER DIVIDER -->
        <tr>
          <td height="1" bgcolor="#002b8f"></td>
        </tr>

        <!-- INTRO -->
        <tr>
          <td style="padding: 35px 60px 15px">
            <p style="
                margin: 0 0 25px;
                font-size: 28px;
                color: #063686;
                font-weight: bold;
              ">
              Dear {{ user.parent.name.first }},
            </p>

            <p style="
                margin: 0;
                font-size: 22px;
                line-height: 38px;
                color: #14245d;
              ">
              We hope this message finds you well.
            </p>
          </td>
        </tr>

        <!-- PARENTAL NOTICE CARD -->
        <tr>
          <td style="padding: 30px 55px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                border: 1px solid #bfdbfe;
                border-radius: 12px;
                background: #f0f9ff;
              ">
              <tr>
                <td style="padding: 40px 45px">
                  <h2 style="
                      margin: 0 0 20px;
                      color: #063686;
                      font-size: 30px;
                    ">
                    Parental Approval Required
                  </h2>

                  <p style="
                      margin: 0 0 20px;
                      color: #17285f;
                      font-size: 20px;
                      line-height: 34px;
                    ">
                    Your child,
                    <strong>{{ user.name.first }}</strong>,  
                    has registered on
                    <a href="https://{{user.origin}}" style="
                        color: #063686;
                        text-decoration: none;
                        font-weight: bold;
                      ">
                      Turn2Opinion
                    </a>,  
                    an online survey and market research panel platform
                    published by Frequent Research Fieldwork Solutions Pvt.
                    Ltd. As they have indicated that they are under the age
                    of 18, we require verified parental approval before
                    allowing access to our platform.
                  </p>

                  <p style="
                      margin: 0;
                      color: #17285f;
                      font-size: 20px;
                      line-height: 34px;
                    ">
                    Turn2Opinion allows members to participate in surveys and  
                    earn rewards by sharing opinions on various topics. We are
                    committed to maintaining a safe and secure environment for
                    all participants, especially minors.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- WHY YOU ARE RECEIVING THIS EMAIL -->
        <tr>
          <td style="padding: 0 55px 30px">
            <h3 style="
                margin: 0 0 15px;
                color: #063686;
                font-size: 24px;
              ">
              Why You Are Receiving This Email
            </h3>

            <p style="
                margin: 0;
                font-size: 18px;
                line-height: 30px;
                color: #22305f;
              ">
              During registration, your child provided your email address as  
              the {{ user.parent.relation }}. In accordance with our Child  
              Protection and Privacy Policy, we require verified parental
              approval before allowing access to our platform.
            </p>
          </td>
        </tr>

        <!-- WHAT WE COLLECT -->
        <tr>
          <td style="padding: 0 55px 30px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #f8fbff;
                border: 1px solid #d7e4ff;
                border-radius: 10px;
              ">
              <tr>
                <td style="padding: 25px 30px">
                  <h3 style="
                      margin: 0 0 15px;
                      color: #063686;
                      font-size: 24px;
                    ">
                    What We Collect
                  </h3>

                  <p style="
                      margin: 0 0 12px;
                      font-size: 18px;
                      line-height: 30px;
                      color: #22305f;
                    ">
                    With your consent, we may collect:
                  </p>

                  <ul style="
                      margin: 0;
                      padding-left: 25px;
                      color: #22305f;
                      font-size: 18px;
                      line-height: 32px;
                    ">
                    <li>Basic profile information (name, age, gender)</li>
                    <li>Survey participation responses</li>
                    <li>Reward-related details (if applicable)</li>
                  </ul>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- PARENT/GUARDIAN RIGHTS -->
        <tr>
          <td style="padding: 0 55px 30px">
            <h3 style="
                margin: 0 0 15px;
                color: #063686;
                font-size: 24px;
              ">
              Your Rights as a Parent/Guardian
            </h3>

            <p style="
                margin: 0 0 12px;
                font-size: 18px;
                line-height: 30px;
                color: #22305f;
              ">
              You have the right to:
            </p>

            <ul style="
                margin: 0;
                padding-left: 25px;
                color: #22305f;
                font-size: 18px;
                line-height: 32px;
              ">
              <li>
                Review your child's information
              {% comment %}
                shared with us (only), on an exclusive request on email
              {% endcomment %}
              </li>

              <li>
                Withdraw consent at any time
              {% comment %}
                by making a request on
                <a mailto:support@{{user.origin}}>
                support@{{user.origin}}
                </a>
              {% endcomment %}
              </li>

              <li>
                Request account deletion
              {% comment %}
                by generating a support ticket or writing email to
                <a mailto:support@{{user.origin}}>
                support@{{user.origin}}
                </a>
              {% endcomment %}
              </li>

              <li>
                Contact us for any clarification
              </li>
            </ul>
          </td>
        </tr>

        <!-- Verification CTA -->
        <tr>
          <td style="padding:25px 55px 20px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
           border: 1px solid #bfdbfe;
                border-radius: 12px;
                background: #f0f9ff;
          ">
              <tr>
                <td align="center" style="
                padding:38px 35px;
              ">
                  <p style="
                margin:0 0 10px;
                font-size:17px;
                font-weight:bold;
                letter-spacing:1.5px;
                text-transform:uppercase;
              ">
                    Action Required
                  </p>

                  <h2 style="
                margin:0 0 14px;
               color:#002b8f;
                font-size:30px;
                line-height:40px;
              ">
                    Approve Your Child's Registration
                  </h2>

                  <p style="
                margin:0 auto 25px;
                max-width:650px;
                              font-size:17px;
                line-height:28px;
              ">
                    Please verify that you are the legal parent or guardian   
                and approve your child's participation on
                Turn2Opinion.
                  </p>

                  <a
                    href="https://{{user.origin}}/auth/parent-consent?user={{user._id}}&code={{otp.code}}"
                    target="_blank"
                    style="
                  display:inline-block;
                  background:#002b8f;
                  color:#ffffff;
                  text-decoration:none;
                  padding:15px 40px;
                  border-radius:10px;
                  font-size:17px;
                  font-weight:bold;
                ">
                    VERIFY &amp; APPROVE
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- CLOSING -->
        <tr>
          <td style="padding: 0 55px 35px">
            <p style="
                margin: 0;
                font-size: 18px;
                line-height: 30px;
                color: #22305f;
              ">
              We appreciate your cooperation in helping us maintain a safe  
              and responsible research environment.
            </p>
          </td>
        </tr>

        {% include "mailer/footer.liquid" %}
        <!-- BOTTOM BLUE BAR -->
        <tr>

          <td
            height="10"
            bgcolor="#0c5adb"
            style="background:#0c5adb;"></td>

        </tr>
      </table>
    </td>
  </tr>
</table>