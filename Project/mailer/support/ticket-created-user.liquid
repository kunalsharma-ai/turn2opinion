<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Support Ticket Confirmation</title>
  </head>
  <body style="margin:0; padding:0; background:#f4f4f4;">
    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      bgcolor="#f4f4f4"
      style="
    margin:0;
    padding:0;
    background:#f4f4f4;
    font-family:Arial, Helvetica, sans-serif;
  ">
      <tr>
        <td align="center">
          <table
            width="920"
            border="0"
            cellspacing="0"
            cellpadding="0"
            bgcolor="#ffffff"
            style="max-width:920px; width:100%;">
            <!-- TOP BORDER -->
            <tr>
              <td height="12" bgcolor="#002b8f"></td>
            </tr>
            <!-- LOGO SECTION -->
            <tr>
              <td align="center" style="padding:30px 20px; background:#ffffff;">
                <img
                  src="https://www.turn2opinion.com/images/logo/t2o-logo.png"
                  alt="Turn2Opinion.com"
                  width="420"
                  style="
                display:block;
                max-width:100%;
                height:auto;
              " />
              </td>
            </tr>
            <!-- DIVIDER -->
            <tr>
              <td height="1" bgcolor="#002b8f"></td>
            </tr>
            <!-- INTRO -->
            <tr>
              <td style="padding:35px 60px 15px;">
                <p style="
                margin:0 0 25px;
                font-size:28px;
                color:#063686;
                font-weight:bold;
              ">
                  Hi {{ user.name }},
                </p>
                <p style="
                margin:0;
                font-size:22px;
                line-height:38px;
                color:#14245d;
              ">
                  Thank you for reaching out to us. This is to confirm that 
              we have received your support request and your ticket has
              been successfully created.
                </p>
              </td>
            </tr>
            <!-- TICKET CARD -->
            <tr>
              <td style="padding:30px 55px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
                border:1px solid #bfdbfe;
                border-radius:12px;
                background:#f0f9ff;
              ">
                  <tr>
                    <!-- ICON -->
                    <td
                      width="220"
                      align="center"
                      valign="middle"
                      style="padding:40px 10px;">
                      <img
                        src="https://frequentresearch.com/mailer/mail-icons/t2o/mail.png"
                        width="160"
                        alt="Support Ticket"
                        style="
                      display:block;
                      max-width:100%;
                    " />
                    </td>
                    <!-- TICKET INFORMATION -->
                    <td style="padding:35px 25px 35px 10px;">
                      <h2 style="
                      margin:0 0 20px;
                      color:#063686;
                      font-size:30px;
                    ">
                        Ticket Created
                      </h2>
                      <p style="
                      margin:0 0 20px;
                      color:#17285f;
                      font-size:20px;
                      line-height:32px;
                    ">
                        Your support request has been registered with our 
                    support team.
                      </p>
                      <table
                        width="100%"
                        border="0"
                        cellspacing="0"
                        cellpadding="0">
                        <tr>
                          <td width="130" style="
                          padding:8px 0;
                          color:#063686;
                          font-size:18px;
                          font-weight:bold;
                          vertical-align:top;
                        ">
                            Ticket ID:
                          </td>
                          <td style="
                          padding:8px 0;
                          color:#17285f;
                          font-size:18px;
                          font-weight:bold;
                          vertical-align:top;
                        ">
                            {{ data.ticketNo }}
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <!-- RESPONSE NOTICE -->
            <tr>
              <td style="padding:0 55px 35px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
                background:#f8fbff;
                border:1px solid #d7e4ff;
                border-radius:10px;
              ">
                  <tr>
                    <td
                      width="120"
                      align="center"
                      valign="middle"
                      style="padding:25px;">
                      <img
                        src="https://frequentresearch.com/mailer/mail-icons/t2o/shield.png"
                        width="100"
                        alt="Support"
                        style="display:block;" />
                    </td>
                    <td style="padding:25px 25px 25px 0;">
                      <h3 style="
                      margin:0 0 10px;
                      color:#063686;
                      font-size:22px;
                    ">
                        What Happens Next?
                      </h3>
                      <p style="
                      margin:0;
                      font-size:18px;
                      line-height:30px;
                      color:#22305f;
                    ">
                        Our support team is currently reviewing your request 
                    and will get back to you within
                        <strong>24 to 48 hours</strong>
                        with an update.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <!-- IMPORTANT NOTICE -->
            <tr>
              <td style="padding:0 55px 35px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
                background:#ffffff;
                border:1px solid #d7e4ff;
                border-radius:10px;
              ">
                  <tr>
                    <td style="padding:25px;">
                      <h3 style="
                      margin:0 0 10px;
                      color:#063686;
                      font-size:22px;
                    ">
                        Important
                      </h3>
                      <p style="
                      margin:0;
                      font-size:18px;
                      line-height:30px;
                      color:#22305f;
                    ">
                        If you have any additional details to share,
                        <strong>please do not reply to this email.</strong>
                        To add more information or respond, please use the 
                    Support Ticket system only.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <!-- CLOSING -->
            <tr>
              <td style="padding:0 55px 35px;">
                <p style="
                margin:0;
                font-size:20px;
                line-height:34px;
                color:#14245d;
              ">
                  Thank you for your patience and cooperation. We appreciate 
              you taking the time to contact us.
                </p>
              </td>
            </tr>
            {% include "mailer/footer.liquid" %}
            <!-- BOTTOM BLUE BAR -->
            <tr>

              <td
                height="10"
                bgcolor="#0c5adb"
                style="background:#0c5adb;"></td>

            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>