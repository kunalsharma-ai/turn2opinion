<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>New Support Ticket</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f7f7f7;
            margin: 0;
            padding: 0;
        }
        .container {
            background: #fff;
            max-width: 600px;
            margin: 40px auto;
            padding: 32px 24px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        }
        h2 {
            color: #2d6cdf;
            margin-top: 0;
        }
        .ticket-info {
            margin: 24px 0;
            padding: 16px;
            background: #f0f4fa;
            border-radius: 6px;
        }
        .ticket-info strong {
            display: inline-block;
            width: 110px;
            color: #333;
        }
        .footer {
            margin-top: 32px;
            color: #888;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Support Ticket [{{reply.ticketNo}}] is updated by {{repliedBy.fullName}}</h2>
        {{reply.message}}
        <div class="footer">
            Thank you,<br>
            {{repliedBy.fullName}}<br>
            Support Team
        </div>
    </div>
</body>
</html>
