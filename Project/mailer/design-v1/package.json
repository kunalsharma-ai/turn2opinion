{
  "name": "turn2opinion-mailers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn2Opinion email system — React source of truth that emits static HTML, Liquid templates and plain-text parts for 22 mailers.",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:liquid": "node scripts/build.mjs --only=liquid",
    "build:html": "node scripts/build.mjs --only=html",
    "lint": "node scripts/lint-liquid.mjs",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs",
    "docs": "node scripts/docs.mjs",
    "serve": "node scripts/server.mjs",
    "send:test": "node scripts/send.mjs",
    "art": "node ../art/build-art.mjs && python3 ../art/squeeze.py"
  },
  "dependencies": {
    "express": "^4.19.2",
    "liquidjs": "^10.16.1",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
